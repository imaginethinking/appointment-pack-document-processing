APP_NAME='Appointment Pack Document Processing'
APP_ENVIRONMENT=development
APP_INTERNAL_API_KEY=replace-with-a-long-random-value
APP_MAXIMUM_FILE_SIZE_BYTES=10485760
APP_MAXIMUM_PDF_PAGES=50

APP_OCR_LANGUAGE=eng
APP_OCR_DPI=300
APP_OCR_PREPROCESSING_ENABLED=true
APP_OCR_MINIMUM_IMAGE_WIDTH=1600

# Required only when tesseract.exe is not available through PATH.
# APP_TESSERACT_COMMAND='C:/Program Files/Tesseract-OCR/tesseract.exe'